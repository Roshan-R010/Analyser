<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Statement Analysis – {{ r.borrower }}</title>
<style>{{ css|safe }}</style>
</head>
<body>

{# ============================================================ BLOCK TABLE (one style for every page) #}
{% macro block_table(columns, blocks) %}
<table class="loantable">
  <colgroup>{% for c in columns %}<col style="width:{{ c.w }}%">{% endfor %}</colgroup>
  <thead><tr>{% for c in columns %}<th class="{{ c.c }}">{{ c.name }}</th>{% endfor %}</tr></thead>
  {% for b in blocks %}
  <tbody class="lender{{ ' long' if b.rows|length > 18 }}">
    <tr class="lhead {{ 'bad' if b.bad }}"><td colspan="{{ columns|length - 1 }}"><div class="lname">{{ b.title }}</div><div class="sub">{{ b.subline }}</div></td>
      <td class="n lpaid">{{ b.right }}</td></tr>
    {% for row in b.rows %}
    <tr class="{{ row.cls }}">{% for c in row.cells %}<td class="{{ c.c }}"{% if c.span %} colspan="{{ c.span }}"{% endif %}>{{ c.t }}{% if c.s %}<div class="sub">{{ c.s }}</div>{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
{% endmacro %}

{# ============================================================ SUMMARY (first page, same look as the pages after it) #}
<section class="summary">
<div class="pagehead">
  <div><div class="eyebrow">Bank statement analysis</div><h1>{{ r.borrower }}</h1><div class="muted">{{ accounts_line }}</div></div>
  <div class="period">{{ short_period }}<div class="muted gen">Generated {{ generated }}</div></div>
</div>

{% if r.suspicious %}
<div class="verdict bad">
  <div class="vtitle">Suspicious statement</div>
  <div class="vtext">
    {% for s in r.suspicious %}
    <p><b>Statement {{ s.statement_no }}: the numbers do not add up.</b>
      {% if not s.breaks %}{% for p in s.problems %}{{ p }}. {% endfor %}{% endif %}</p>
    <ul>{% for w in s.what_might_be_wrong %}<li>{{ w }}</li>{% endfor %}</ul>
    {% endfor %}
    <p class="muted">The figures in this report are read from the statement as printed. Treat them with care until the original is checked.</p>
  </div>
</div>
{% elif r.all_checks_ok %}
<div class="verdict ok"><div class="vtitle">Verified</div>
  <div class="vtext">Every balance and every total in the statement adds up, and every figure in this report was cross-checked.</div></div>
{% else %}
<div class="verdict bad"><div class="vtitle">Check failed</div>
  <div class="vtext">Some cross-checks failed. They are listed under Checks below.</div></div>
{% endif %}

<div class="stats">
  <div><div class="label">Money in · {{ r.cashflow.total.cr_entries|int }} entries</div><div class="big">₹{{ r.cashflow.total.credit|inr }}</div></div>
  <div><div class="label">Money out · {{ r.cashflow.total.dr_entries|int }} entries</div><div class="big">₹{{ r.cashflow.total.debit|inr }}</div></div>
  <div><div class="label">Net cashflow</div><div class="big">₹{{ r.cashflow.total.net|inr }}</div></div>
  <div><div class="label">Average balance</div><div class="big">₹{{ r.cashflow.total.avg_balance|inr }}</div></div>
</div>
<div class="stats small">
  <div><div class="label">Cheque bounces (funds / other)</div><div class="mid">{{ funds_count }} / {{ r.returns.bounces|length - funds_count }}</div></div>
  <div><div class="label">Lenders paid</div><div class="mid">{{ r.loans|selectattr('payments')|rejectattr('type', 'equalto', 'Possible lender')|list|length }}</div></div>
  <div><div class="label">Statements</div><div class="mid">{{ r.statements|length }}</div></div>
</div>

{% if suspicion_page.blocks %}
<h2 class="sec">Where it does not add up</h2>
{{ block_table(suspicion_page.cols, suspicion_page.blocks) }}
<p class="note">"Should be" is the balance before the entry plus the entry. "Printed" is what the statement shows.
Page numbers are the page of the statement PDF.</p>
{% endif %}

<h2 class="sec">Statements</h2>
<table class="loantable plain">
  <colgroup><col style="width:3%"><col style="width:11%"><col style="width:19%"><col style="width:10%"><col style="width:21%">
    <col style="width:11%"><col style="width:11%"><col style="width:6%"><col style="width:8%"></colgroup>
  <thead><tr><th>#</th><th>Bank</th><th>Account holder</th><th>Account</th><th>Period</th>
    <th class="n">Opening (₹)</th><th class="n">Closing (₹)</th><th class="n">Entries</th><th>Status</th></tr></thead>
  <tbody>
  {% for s in r.statements %}{% set st = s.statement %}
    <tr><td>{{ st.statement_no }}</td><td>{{ bank_name(st.bank) }}</td><td>{{ st.account_holder or '–' }}</td>
      <td>{{ mask(st.account_no) }}</td><td>{{ st.period_from|d }} – {{ st.period_to|d }}</td>
      <td class="n">{{ st.opening_balance|inr2 }}</td>
      <td class="n">{{ (st.transactions[-1].balance if st.transactions else None)|inr2 }}</td>
      <td class="n">{{ st.transactions|length }}</td>
      <td class="{{ 'warnword' if st.statement_no in suspect_nos else 'goodword' }}">{{ 'Suspicious' if st.statement_no in suspect_nos else 'Verified' }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2 class="sec">Flags</h2>
{% if r.flags %}
<div class="flaglist">
  {% for f in r.flags %}
  <div class="flag {{ f.level }}"><span class="lvl">{{ {'high': 'High', 'watch': 'Watch', 'info': 'Note'}[f.level] }}</span><span>{{ f.text }}</span></div>
  {% endfor %}
</div>
{% else %}<p class="muted">Nothing to flag.</p>{% endif %}

<h2 class="sec">Checks</h2>
<div class="checklist">
  {% for c in r.checks %}
  <div class="chk {{ 'ok' if c.ok else 'bad' }}"><span class="lvl">{{ 'Pass' if c.ok else 'Fail' }}</span>
    <span>{{ c.name }}{% if c.detail %} <span class="muted">· {{ c.detail }}</span>{% endif %}</span></div>
  {% endfor %}
</div>
</section>

{# ============================================================ ORIGINAL STATEMENTS #}
{% for s in r.statements %}{% if s.first_page_png %}
<section class="page statement-pic">
  <h2>Statement {{ s.statement.statement_no }} <span class="muted">· {{ bank_name(s.statement.bank) }} · first page</span></h2>
  <img src="data:image/png;base64,{{ s.first_page_png|b64 }}" alt="First page of statement {{ s.statement.statement_no }}">
</section>
{% endif %}{% endfor %}

{# ============================================================ CASHFLOW #}
<section class="page loans">
<div class="pagehead">
  <div><h1>Cashflow Summary</h1><div class="muted">{{ accounts_line }} · month by month</div></div>
  <div class="period">{{ short_period }}</div>
</div>
<div class="stats">
  <div><div class="label">Money in · {{ r.cashflow.total.cr_entries|int }} entries</div><div class="big">₹{{ r.cashflow.total.credit|inr }}</div></div>
  <div><div class="label">Money out · {{ r.cashflow.total.dr_entries|int }} entries</div><div class="big">₹{{ r.cashflow.total.debit|inr }}</div></div>
  <div><div class="label">Net cashflow</div><div class="big">₹{{ r.cashflow.total.net|inr }}</div></div>
  <div><div class="label">Average balance</div><div class="big">₹{{ r.cashflow.total.avg_balance|inr }}</div></div>
</div>
{{ block_table(cash_page.cols, cash_page.blocks) }}
<p class="note">Avg balance = average of each day's closing balance. Returns are counted in the month the bounce happened.</p>
</section>

{# ============================================================ RETURNS #}
<section class="page loans">
<div class="pagehead">
  <div><h1>Chq/ECS Return Txns</h1><div class="muted">{{ accounts_line }} · grouped by reason</div></div>
  <div class="period">{{ short_period }}</div>
</div>
<div class="stats">
  <div><div class="label">Returns · {{ funds_count }} for insufficient funds</div><div class="big">{{ r.returns.bounces|length }}</div></div>
  <div><div class="label">Amount returned</div><div class="big">₹{{ returns_money|inr }}</div></div>
  <div><div class="label">Return charges</div><div class="big">₹{{ returns_charges|inr }}</div></div>
  <div><div class="label">Transfers sent back</div><div class="big">{{ r.returns.transfer_returns|length }}</div></div>
</div>
{% if returns_page.blocks %}{{ block_table(returns_page.cols, returns_page.blocks) }}
{% else %}<p class="muted">No cheque or ECS returns.</p>{% endif %}
{% if returns_page.sent_blocks %}{{ block_table(returns_page.sent_cols, returns_page.sent_blocks) }}{% endif %}
<p class="note">Bank balance is the statement balance after each entry. "+" marks money in.
Transfers sent back (NEFT / RTGS / IMPS / UPI returns and reversals) are listed apart because they are not cheque bounces.</p>
</section>

{# ============================================================ RECURRING #}
<section class="page rec">
<div class="pagehead">
  <div><h1>Recurring payments</h1><div class="muted">{{ accounts_line }}</div></div>
  <div class="period">{{ short_period }}</div>
</div>
{% if r.recurring %}
<div class="statbox">
  <div><div class="label">Total paid to parties shown</div><div class="big">₹{{ r.recurring|sum(attribute='total')|inr }}</div></div>
  <div><div class="label">Payments</div><div class="mid">{{ r.recurring|sum(attribute='entries') }}</div></div>
  <div><div class="label">Parties</div><div class="mid">{{ r.recurring|length }}</div></div>
</div>
<table class="rectable">
  <colgroup><col style="width:24%"><col style="width:8%"><col style="width:20%"><col></colgroup>
  <thead><tr><th>Payment amount</th><th class="c">Count</th><th>Observed pattern</th>
    <th>Payment dates{% if rec_year %} · {{ rec_year }}{% endif %}</th></tr></thead>
  {% for x in r.recurring %}
  <tbody class="party">
    <tr class="band"><td colspan="3">{{ title(x.party) }}</td><td class="n">Total ₹{{ x.total|inr }}</td></tr>
    {% for ln in x.lines %}
    <tr>
      <td>{% if ln.amount is none %}<b>Variable amounts</b>
          {% elif ln.odd %}<b>₹{{ ln.amount|inr2 }} × {{ ln.main_count }}</b>
            {% for a, d in ln.odd %}<div class="sub">₹{{ a|inr2 }} × 1 ({{ '%02d %s'|format(d.day, d.strftime('%b')) }})</div>{% endfor %}
          {% else %}<b>₹{{ ln.amount|inr2 }}</b>{% endif %}
          {% if ln.note %}<div class="sub">{{ ln.note }}</div>{% endif %}</td>
      <td class="c">{{ ln.count }}</td>
      <td>{{ ln.pattern }}</td>
      <td class="dates">{{ month_dates(ln.dates, not rec_year) }}</td>
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
<p class="note"><b>Party totals cover the statement period, not a monthly commitment.</b><br>
Monthly patterns use actual payment dates. Extra payments stay separate.
Variable amounts are grouped by party; totals are rounded to the nearest rupee.
A party is shown when paid 3 or more times in the statement (₹10,000+ in total, or any lender). Monthly and weekly patterns appear when the statement is long enough to show them.</p>
{% else %}<p class="muted">No recurring payments: no party was paid 3 or more times (₹10,000+ in total, or any lender) in this statement.</p>{% endif %}
</section>

{# ============================================================ LOANS #}
<section class="page loans">
<div class="pagehead">
  <div><h1>Loan transactions</h1><div class="muted">{{ accounts_line }} · grouped by lender and payment mandate</div></div>
  <div class="period">{{ short_period }}</div>
</div>
{% if loan_blocks %}
<div class="stats">
  <div><div class="label">Total paid{% if loan_has_chit %} · including chit fund{% endif %}</div><div class="big">₹{{ loan_paid|inr }}</div></div>
  <div><div class="label">Usual EMIs · {{ loan_emis|length }} payment stream{{ 's' if loan_emis|length != 1 }}</div><div class="big">₹{{ loan_emis|sum|inr }}</div></div>
  <div><div class="label">Payments</div><div class="big">{{ r.loans|sum(attribute='payments') }}</div></div>
  {% if loan_received %}<div><div class="label">Received from lenders</div><div class="big">₹{{ loan_received|inr }}</div></div>{% endif %}
</div>
<table class="loantable">
  <colgroup><col style="width:15%"><col style="width:16%"><col style="width:19%"><col></colgroup>
  <thead><tr><th>Date{% if loan_year %} · {{ loan_year }}{% endif %}</th><th class="n">Paid (₹)</th><th class="n">Bank balance (₹)</th><th>Payment details</th></tr></thead>
  {% for b in loan_blocks %}
  <tbody class="lender{{ ' long' if b.rows|length > 18 }}">
    <tr class="lhead"><td colspan="3"><div class="lname">{{ b.title }}</div><div class="sub">{{ b.subline }}</div></td>
      <td class="n lpaid">{% if b.paid %}Paid ₹{{ b.paid|inr }}{% endif %}{% if b.received %}<div>Received ₹{{ b.received|inr }}</div>{% endif %}</td></tr>
    {% for t, what in b.rows %}
    <tr class="{{ 'in' if t.credit }}">
      <td>{{ t.date.strftime('%d %b') if loan_year else t.date.strftime('%d %b %y') }}</td>
      <td class="n amt">{% if t.credit %}+{{ t.credit|inr2 }}{% else %}{{ t.debit|inr2 }}{% endif %}</td>
      <td class="n">{{ t.balance|inr }}</td>
      <td>{{ what }}</td>
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
<p class="note">Bank balance is the statement balance after each entry. Payment groups are based on the transaction narration.
"+" marks money received from the lender.</p>
{% else %}<p class="muted">No loan payments or disbursements found: no known lender, finance or chit-fund name, and no EMI, installment or loan wording, appears in this statement.</p>{% endif %}
</section>

{# ============================================================ COUNTERPARTIES #}
<section class="page cp">
<div class="pagehead">
  <div><h1>Counterparty totals</h1><div class="muted">{{ accounts_line }} · credits and debits by party, month by month</div></div>
  <div class="period">{{ short_period }}</div>
</div>
{% for mp in r.month_parties %}
{% set rh = [[(840 / ([mp.credits|length, mp.debits|length]|max + 1))|int, 58]|min, 28]|max %}
<div class="cpmonth">
<table class="cptable" style="--rh:{{ rh }}px">
  <colgroup><col style="width:24%"><col style="width:13%"><col style="width:9%">
    <col style="width:29%"><col style="width:15%"><col style="width:10%"></colgroup>
  <thead>
    <tr><th colspan="6" class="cptitle">CounterParty Totals - {{ mp.month.strftime('%b %Y') }}</th></tr>
    <tr><th>Counterparty (Cr)</th><th class="n">Amount (Cr)</th><th class="c">Entries (Cr)</th>
      <th>Counterparty (Dr)</th><th class="n">Amount (Dr)</th><th class="c">Entries (Dr)</th></tr>
  </thead>
  <tbody>
    <tr class="tot"><td>Total ({{ mp.month.strftime('%b %Y') }})</td><td class="n">{{ mp.credit_total|inr }}</td><td class="c">{{ mp.credit_entries }}</td>
      <td>Total ({{ mp.month.strftime('%b %Y') }})</td><td class="n">{{ mp.debit_total|inr }}</td><td class="c">{{ mp.debit_entries }}</td></tr>
    {% for i in range([mp.credits|length, mp.debits|length]|max) %}
    {% set c = mp.credits[i] if i < mp.credits|length else none %}{% set d = mp.debits[i] if i < mp.debits|length else none %}
    <tr>
      {% if c %}<td class="{{ 'special' if c.key.startswith('_') }}">{{ title(c.name) }}</td><td class="n">{{ c.amount|inr }}</td><td class="c">{{ c.entries }}</td>
      {% else %}<td></td><td></td><td></td>{% endif %}
      {% if d %}<td class="{{ 'special' if d.key.startswith('_') }}">{{ title(d.name) }}</td><td class="n">{{ d.amount|inr }}</td><td class="c">{{ d.entries }}</td>
      {% else %}<td></td><td></td><td></td>{% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{% if loop.last and r.parties.possibly_same %}
<p class="note">Possibly the same party (kept separate): {% for a, b, s in r.parties.possibly_same[:8] %}<b>{{ title(r.parties.name(a)) }}</b> / <b>{{ title(r.parties.name(b)) }}</b>{{ '; ' if not loop.last }}{% endfor %}</p>
{% endif %}
</div>
{% endfor %}
</section>

{# ============================================================ BLOCK TABLE (loan-page layout) #}
{% macro entry_table(blocks, chq=false) %}
<table class="loantable">
  {% if chq %}<colgroup><col style="width:11%"><col style="width:10%"><col style="width:14%"><col style="width:14%"><col></colgroup>
  {% else %}<colgroup><col style="width:11%"><col style="width:15%"><col style="width:15%"><col></colgroup>{% endif %}
  <thead><tr><th>Date{% if all_year %} · {{ all_year }}{% endif %}</th>{% if chq %}<th>Chq no</th>{% endif %}
    <th class="n">Amount (₹)</th><th class="n">Bank balance (₹)</th><th>{{ 'Counterparty' if chq else 'Payment details' }}</th></tr></thead>
  {% for b in blocks %}
  <tbody class="lender{{ ' long' if b.rows|length > 18 }}">
    <tr class="lhead {{ 'bad' if b.bad }}"><td colspan="{{ 4 if chq else 3 }}"><div class="lname">{{ b.title }}</div><div class="sub">{{ b.subline }}</div></td>
      <td class="n lpaid">{{ b.right }}</td></tr>
    {% for t, main, sub in b.rows %}
    <tr class="{{ 'in' if t.credit }}">
      <td>{{ t.date.strftime('%d %b') if all_year else t.date.strftime('%d %b %y') }}</td>
      {% if chq %}<td>{{ t.cheque_no or '–' }}</td>{% endif %}
      <td class="n amt">{% if t.credit %}+{{ t.credit|inr2 }}{% else %}{{ t.debit|inr2 }}{% endif %}</td>
      <td class="n">{{ t.balance|inr }}</td>
      <td>{{ title(main) if chq else main }}{% if sub %}<div class="sub">{{ sub }}</div>{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
{% endmacro %}

{# ============================================================ UNKNOWN #}
<section class="page loans">
<div class="pagehead">
  <div><h1>Unknown transactions</h1><div class="muted">{{ accounts_line }} · entries where the bank shows no party name</div></div>
  <div class="period">{{ short_period }}</div>
</div>
{% set ul = r.unknown.listed %}
<div class="stats">
  {% set nin = ul|selectattr('credit')|list|length %}{% set nout = ul|selectattr('debit')|list|length %}
  {% if nin %}<div><div class="label">Money in · {{ nin }} entr{{ 'ies' if nin != 1 else 'y' }}</div><div class="big">₹{{ ul|sum(attribute='credit')|inr }}</div></div>{% endif %}
  {% if nout %}<div><div class="label">Money out · {{ nout }} entr{{ 'ies' if nout != 1 else 'y' }}</div><div class="big">₹{{ ul|sum(attribute='debit')|inr }}</div></div>{% endif %}
  {% if r.unknown.small_count %}<div><div class="label">Smaller entries (not listed) · {{ r.unknown.small_count }}</div><div class="big">₹{{ r.unknown.small_total|inr }}</div></div>{% endif %}
</div>
{% if unknown_blocks %}{{ entry_table(unknown_blocks) }}{% else %}<p class="muted">No unknown entries of ₹10,000 or more.</p>{% endif %}
<p class="note">Listed: entries of ₹10,000 and above. Bank balance is the statement balance after each entry. "+" marks money in.</p>
</section>

{# ============================================================ CHEQUES #}
<section class="page loans">
<div class="pagehead">
  <div><h1>Cheque-wise transactions</h1><div class="muted">{{ accounts_line }} · in cheque number order</div></div>
  <div class="period">{{ short_period }}</div>
</div>
{% if cheque_blocks %}
<div class="stats">
  {% for b in cheque_blocks %}<div><div class="label">{{ b.title }} · {{ b.rows|length }}</div><div class="big">{{ b.total }}</div></div>{% endfor %}
</div>
{{ entry_table(cheque_blocks, true) }}
<p class="note">Bank balance is the statement balance after each entry. "+" marks money in.</p>
{% else %}<p class="muted">No cheques.</p>{% endif %}
</section>

{# ============================================================ CHARTS #}
<section class="page">
<h2>Visual Analytics</h2>
<h3>Monthly money in vs money out</h3>
<div class="chart">{{ chart_bars|safe }}</div>
<h3>Average monthly balance</h3>
<div class="chart">{{ chart_line|safe }}</div>
<div class="cols">
  <div><h3>Money in by payment mode</h3><div class="chart">{{ chart_modes_in|safe }}</div></div>
  <div><h3>Money out by payment mode</h3><div class="chart">{{ chart_modes_out|safe }}</div></div>
</div>
<p class="note">Percentages add up to exactly 100%. The numbers behind every chart are in the tables above.</p>
</section>

</body>
</html>
